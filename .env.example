# Copy to `.env` (git-ignored) before building.
#
# Passwords for posts tagged `private` — one per post, no shared password.
# The name is PRIVATE_POST_PASSWORD_ + the file name, upper-cased, with every
# run of non-alphanumeric characters replaced by "_":
#
#   src/content/posts/my-secret-note.mdx  ->  PRIVATE_POST_PASSWORD_MY_SECRET_NOTE
#
# The rendered body is encrypted with this value at build time: the page ships
# only the ciphertext, so the password never appears in the HTML, the JS bundle
# or the repository.
PRIVATE_POST_PASSWORD_MY_SECRET_NOTE=
