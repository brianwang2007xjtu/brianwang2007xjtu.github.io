---
/**
 * Clean, theme-aware vector circuit diagrams for the analog-electronics notes.
 * Redrawn from scratch (the lecture slides' screenshots are blurry and messy).
 *
 * Usage in MDX:
 *   <CircuitDiagram type="fixed-bias" />
 *   <CircuitDiagram type="divider-bias" caption="分压式偏置共射电路" />
 *
 * Types: fixed-bias | divider-bias | load-line | small-signal
 */
interface Props {
  type: "fixed-bias" | "divider-bias" | "load-line" | "small-signal";
  caption?: string;
}

const { type, caption } = Astro.props;

const CAPTIONS: Record<Props["type"], string> = {
  "fixed-bias": "共射放大电路直流通路（单电源）：R_b 提供基极偏置，R_c 为集电极负载",
  "divider-bias": "分压式偏置共射放大电路",
  "load-line": "输出特性、直流负载线与静态工作点 Q",
  "small-signal": "晶体管微变等效电路",
};
const label = caption ?? CAPTIONS[type];
---

<figure class="circuit not-prose" data-circuit={type}>
  <svg
    viewBox="0 0 340 240"
    role="img"
    aria-label={label}
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- ===== 固定偏置共射放大电路 ===== -->
    {
      type === "fixed-bias" && (
        <g>
          {/* Vcc rail */}
          <line x1="110" y1="30" x2="250" y2="30" />
          <circle cx="180" cy="30" r="2.6" class="node" />
          <text x="180" y="20" class="lbl mid">V<tspan class="sub">CC</tspan></text>

          {/* Rb branch */}
          <line x1="110" y1="30" x2="110" y2="70" />
          <rect x="101" y="70" width="18" height="38" rx="3" class="part" />
          <line x1="110" y1="108" x2="110" y2="150" />
          <line x1="110" y1="150" x2="185" y2="150" />
          <circle cx="110" cy="150" r="2.6" class="node" />
          <text x="86" y="94" class="lbl end">R<tspan class="sub">b</tspan></text>

          {/* Rc branch */}
          <line x1="250" y1="30" x2="250" y2="70" />
          <rect x="241" y="62" width="18" height="38" rx="3" class="part" />
          <line x1="250" y1="100" x2="250" y2="126" />
          <circle cx="250" cy="126" r="2.6" class="node" />
          <text x="266" y="94" class="lbl">R<tspan class="sub">c</tspan></text>

          {/* BJT */}
          <circle cx="212" cy="150" r="30" class="dev" />
          <line x1="196" y1="136" x2="196" y2="164" class="bar" />
          <line x1="185" y1="150" x2="196" y2="150" />
          <line x1="196" y1="143" x2="212" y2="126" />
          <line x1="212" y1="126" x2="250" y2="126" />
          <line x1="196" y1="157" x2="212" y2="174" />
          <line x1="212" y1="174" x2="212" y2="196" />
          <polygon points="204,164 214,168 206,172" class="arrow" />
          <text x="176" y="134" class="lbl end">b</text>
          <text x="230" y="120" class="lbl">c</text>
          <text x="222" y="190" class="lbl">e</text>

          {/* ground */}
          <line x1="212" y1="196" x2="212" y2="206" />
          <line x1="198" y1="206" x2="226" y2="206" />
          <line x1="203" y1="211" x2="221" y2="211" />
          <line x1="208" y1="216" x2="216" y2="216" />

          {/* currents */}
          <line x1="140" y1="150" x2="176" y2="150" class="cur" marker-end="url(#ar)" />
          <text x="150" y="143" class="cur-lbl">I<tspan class="sub">BQ</tspan></text>
          <line x1="250" y1="106" x2="250" y2="118" class="cur" marker-end="url(#ar)" />
          <text x="258" y="116" class="cur-lbl">I<tspan class="sub">CQ</tspan></text>

          {/* UCE: bracket with leaders so it visibly touches c and e */}
          <line x1="262" y1="126" x2="292" y2="126" class="dash" />
          <line x1="292" y1="126" x2="292" y2="196" class="dash" />
          <line x1="262" y1="196" x2="292" y2="196" class="dash" />
          <line x1="250" y1="126" x2="262" y2="126" class="leader" />
          <line x1="212" y1="196" x2="262" y2="196" class="leader" />
          <text x="300" y="158" class="cur-lbl mid" transform="rotate(90 300 158)">U<tspan class="sub">CEQ</tspan></text>
          <text x="298" y="122" class="pol">+</text>
          <text x="298" y="214" class="pol">−</text>
        </g>
      )
    }

    <!-- ===== 分压式偏置共射放大电路 ===== -->
    {
      type === "divider-bias" && (
        <g>
          <line x1="120" y1="26" x2="240" y2="26" />
          <circle cx="180" cy="26" r="2.6" class="node" />
          <text x="180" y="16" class="lbl mid">V<tspan class="sub">CC</tspan></text>

          {/* Rb1 */}
          <line x1="140" y1="26" x2="140" y2="60" />
          <rect x="131" y="60" width="18" height="38" rx="3" class="part" />
          <line x1="140" y1="98" x2="140" y2="140" />
          <text x="118" y="84" class="lbl end">R<tspan class="sub">b1</tspan></text>

          {/* Rb2 */}
          <line x1="140" y1="140" x2="140" y2="164" />
          <rect x="131" y="164" width="18" height="38" rx="3" class="part" />
          <line x1="140" y1="202" x2="140" y2="214" />
          <text x="118" y="188" class="lbl end">R<tspan class="sub">b2</tspan></text>
          <line x1="126" y1="214" x2="154" y2="214" class="gnd" />
          <line x1="131" y1="219" x2="149" y2="219" class="gnd" />
          <line x1="136" y1="224" x2="144" y2="224" class="gnd" />
          <line x1="140" y1="140" x2="185" y2="140" />
          <circle cx="140" cy="140" r="2.6" class="node" />

          {/* Rc */}
          <line x1="230" y1="26" x2="230" y2="60" />
          <rect x="221" y="60" width="18" height="38" rx="3" class="part" />
          <line x1="230" y1="98" x2="230" y2="116" />
          <circle cx="230" cy="116" r="2.6" class="node" />
          <text x="248" y="84" class="lbl">R<tspan class="sub">c</tspan></text>

          {/* BJT */}
          <circle cx="200" cy="140" r="26" class="dev" />
          <line x1="186" y1="128" x2="186" y2="152" class="bar" />
          <line x1="172" y1="140" x2="186" y2="140" />
          <line x1="186" y1="134" x2="200" y2="120" />
          <line x1="200" y1="120" x2="230" y2="120" />
          <line x1="186" y1="146" x2="200" y2="160" />
          <line x1="200" y1="160" x2="200" y2="176" />

          {/* Re */}
          <rect x="191" y="176" width="18" height="34" rx="3" class="part" />
          <line x1="200" y1="210" x2="200" y2="214" />
          <text x="216" y="196" class="lbl">R<tspan class="sub">e</tspan></text>
          <line x1="186" y1="214" x2="214" y2="214" class="gnd" />
          <line x1="191" y1="219" x2="209" y2="219" class="gnd" />
          <line x1="196" y1="224" x2="204" y2="224" class="gnd" />
          <text x="176" y="128" class="lbl end">b</text>
          <text x="212" y="112" class="lbl">c</text>
          <text x="210" y="170" class="lbl">e</text>
        </g>
      )
    }

    <!-- ===== 直流负载线与 Q 点 ===== -->
    {
      type === "load-line" && (
        <g>
          {/* axes */}
          <line x1="52" y1="204" x2="300" y2="204" class="axis" />
          <line x1="52" y1="204" x2="52" y2="34" class="axis" />
          <polygon points="300,204 291,199.5 291,208.5" class="axis-fill" />
          <polygon points="52,34 47.5,43 56.5,43" class="axis-fill" />
          <text x="303" y="220" class="lbl">u<tspan class="sub">CE</tspan></text>
          <text x="46" y="30" class="lbl end">i<tspan class="sub">C</tspan></text>

          {/* output characteristics (the middle one passes exactly through Q) */}
          <path d="M52 204 C 92 172, 122 140, 160 127.5 C 205 115, 250 113, 300 112" class="curve" />
          <path d="M52 204 C 86 186, 116 168, 160 158 C 210 150, 250 148, 300 147" class="curve" />
          <path d="M52 204 C 84 198, 114 190, 160 184 C 212 178, 250 176, 300 175" class="curve" />
          <text x="304" y="110" class="lbl">I<tspan class="sub">B3</tspan></text>
          <text x="304" y="145" class="lbl">I<tspan class="sub">B2</tspan></text>
          <text x="304" y="173" class="lbl">I<tspan class="sub">B1</tspan></text>

          {/* DC load line: from (0, Vcc/Rc) on the y-axis to (Vcc, 0) on the x-axis */}
          <line x1="52" y1="60" x2="276" y2="204" class="loadline" />
          <circle cx="52" cy="60" r="3" class="node" />
          <text x="60" y="56" class="lbl">V<tspan class="sub">CC</tspan>/R<tspan class="sub">c</tspan></text>
          <circle cx="276" cy="204" r="3" class="node" />
          <text x="264" y="220" class="lbl">V<tspan class="sub">CC</tspan></text>
          <text x="196" y="96" class="lbl">直流负载线</text>
          <line x1="215" y1="100" x2="190" y2="146" class="leader" />

          {/* projections first, marker on top */}
          <line x1="160" y1="127.5" x2="160" y2="204" class="dash" />
          <line x1="160" y1="127.5" x2="52" y2="127.5" class="dash" />
          <text x="160" y="220" class="lbl mid">U<tspan class="sub">CEQ</tspan></text>
          <text x="46" y="131" class="lbl end">I<tspan class="sub">CQ</tspan></text>
          <circle cx="160" cy="127.5" r="4.5" class="qdot" />
          <text x="170" y="122" class="q-lbl">Q</text>
        </g>
      )
    }

    <!-- ===== 微变等效电路 ===== -->
    {
      type === "small-signal" && (
        <g>
          {/* input port: b (top-left) → r_be → emitter rail */}
          <circle cx="96" cy="86" r="2.8" class="node" />
          <text x="84" y="82" class="lbl end">b</text>
          <line x1="96" y1="86" x2="96" y2="112" />
          <rect x="87" y="112" width="18" height="46" rx="3" class="part" />
          <line x1="96" y1="158" x2="96" y2="192" />
          <text x="80" y="140" class="lbl end">r<tspan class="sub">be</tspan></text>
          <line x1="40" y1="86" x2="82" y2="86" class="cur" marker-end="url(#ar)" />
          <text x="46" y="78" class="cur-lbl">i<tspan class="sub">b</tspan></text>

          {/* emitter rail (common to both ports) */}
          <line x1="96" y1="192" x2="250" y2="192" />
          <circle cx="96" cy="192" r="2.8" class="node" />
          <text x="84" y="206" class="lbl end">e</text>

          {/* output port: c (top-right) → dependent current source → emitter rail */}
          <circle cx="250" cy="86" r="2.8" class="node" />
          <text x="262" y="82" class="lbl">c</text>
          <line x1="250" y1="86" x2="250" y2="112" />
          <line x1="250" y1="112" x2="265" y2="134" />
          <line x1="265" y1="134" x2="250" y2="156" />
          <line x1="250" y1="156" x2="235" y2="134" />
          <line x1="235" y1="134" x2="250" y2="112" />
          <line x1="250" y1="134" x2="250" y2="152" class="csrc" marker-end="url(#ar)" />
          <line x1="250" y1="156" x2="250" y2="192" />
          <text x="272" y="138" class="lbl">βi<tspan class="sub">b</tspan></text>
          <line x1="250" y1="86" x2="250" y2="74" class="cur" marker-end="url(#ar)" />
          <text x="256" y="72" class="cur-lbl">i<tspan class="sub">c</tspan></text>
        </g>
      )
    }

    <defs>
      <marker id="ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="arrow-head" />
      </marker>
    </defs>
  </svg>
  <figcaption>{label}</figcaption>
</figure>

<style>
  .circuit {
    margin: 1.5rem 0;
    text-align: center;
  }

  .circuit svg {
    width: 100%;
    max-width: 26rem;
    height: auto;
    margin: 0 auto;
    overflow: visible;
  }

  .circuit figcaption {
    margin-top: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }

  /* wires */
  .circuit :global(line) {
    stroke: var(--foreground);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  /* components (resistors, device outline) */
  .circuit :global(.part) {
    fill: var(--background);
    stroke: var(--foreground);
    stroke-width: 1.6;
  }

  .circuit :global(.dev) {
    fill: none;
    stroke: var(--foreground);
    stroke-width: 1.6;
  }

  .circuit :global(.bar) {
    stroke-width: 3.2;
  }

  .circuit :global(.node) {
    fill: var(--foreground);
    stroke: none;
  }

  .circuit :global(.arrow) {
    fill: var(--foreground);
    stroke: none;
  }

  .circuit :global(.arrow-head) {
    fill: var(--accent);
  }

  .circuit :global(.cur) {
    stroke: var(--accent);
    stroke-width: 1.4;
  }

  .circuit :global(.cur-lbl) {
    fill: var(--accent);
  }

  .circuit :global(.qdot) {
    fill: var(--accent);
    stroke: var(--background);
    stroke-width: 1.5;
  }

  .circuit :global(.q-lbl) {
    fill: var(--accent);
    font-size: 13px;
    font-weight: 600;
  }

  .circuit :global(.csrc) {
    stroke: var(--foreground);
    stroke-width: 1.6;
    fill: none;
  }

  .circuit :global(.axis) {
    stroke: var(--foreground);
    stroke-width: 1.8;
  }

  .circuit :global(.axis-fill) {
    fill: var(--foreground);
    stroke: none;
  }

  .circuit :global(.curve) {
    fill: none;
    stroke: var(--muted-foreground);
    stroke-width: 1.3;
  }

  .circuit :global(.loadline) {
    stroke: var(--accent);
    stroke-width: 1.8;
  }

  .circuit :global(.gnd) {
    stroke: var(--foreground);
    stroke-width: 1.6;
  }

  .circuit :global(.leader) {
    stroke: var(--muted-foreground);
    stroke-width: 1.2;
  }

  .circuit :global(.dash) {
    stroke: var(--muted-foreground);
    stroke-width: 1.2;
    stroke-dasharray: 4 3;
  }

  .circuit :global(.pol) {
    fill: var(--muted-foreground);
    font-size: 12px;
  }

  .circuit :global(text) {
    fill: var(--foreground);
    font-family: var(--font-app);
    font-size: 12.5px;
  }

  .circuit :global(text.mid) {
    text-anchor: middle;
  }

  .circuit :global(text.end) {
    text-anchor: end;
  }

  .circuit :global(.lbl) {
    fill: var(--muted-foreground);
  }

  .circuit :global(.sub) {
    font-size: 9px;
    baseline-shift: -25%;
  }
</style>
