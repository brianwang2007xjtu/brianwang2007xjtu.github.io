---
import { walineServerURL } from "@/data/waline";
const enabled = walineServerURL.trim() !== "";
const server = walineServerURL.trim();
---

{
  enabled && (
    <section data-pagefind-ignore aria-label="Comments">
      <div class="border-border mt-12 border-t pt-8">
        <h2 class="mb-4 text-lg font-semibold">Comments</h2>
        <div id="waline" class="waline"></div>
      </div>
    </section>
  )
}

{
  enabled && (
    <script is:inline define:vars={{ server }}>
      (function () {
        var instance = null;

        var init = function () {
          if (!window.Waline) return;
          if (!document.querySelector("#waline")) return;
          // Re-init on each navigation so the widget matches the current post.
          if (instance) {
            try {
              if (typeof instance.destroy === "function") instance.destroy();
              else if (typeof instance === "function") instance();
            } catch (e) {}
          }
          instance = window.Waline.init({
            el: "#waline",
            serverURL: server,
            path: location.pathname,
            lang: "zh-CN",
            pageview: false,
          });
        };

        var onReady = function () {
          init();
        };
        document.addEventListener("waline-ready", onReady);
        document.addEventListener("astro:page-load", onReady);

        if (window.Waline) init();
      })();
    </script>
  )
}
