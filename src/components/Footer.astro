---
import type { HTMLAttributes } from "astro/types";
import { currentYear as siteYear } from "@/utils/siteTime";

type Props = {
  noMarginTop?: boolean;
  /** Narrow container, matching the home page layout. */
  narrow?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, narrow = false, class: className, ...attrs } =
  Astro.props;

// 年份按站点时区（北京时间），避免跨年时差一年
const currentYear = siteYear();
---

<footer
  class:list={[
    narrow ? "app-layout-home" : "app-layout-wide",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center justify-center gap-1 border-t py-6 text-sm text-muted-foreground"
  >
    <span>
      &#169; {currentYear} master&#39;s blog &#183; All rights reserved.
    </span>
    <span class="text-xs opacity-80">
      Powered by <a href="https://astro.build" class="hover:text-accent">Astro</a>
    </span>
  </div>
</footer>
