---
import type { HTMLAttributes } from "astro/types";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout-wide", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center justify-center gap-1 border-t py-6 text-sm text-muted-foreground"
  >
    <span>
      &#169; {currentYear} master&#39;s blog &#183; All rights reserved.
    </span>
    <span class="text-xs opacity-80">
      Powered by <a href="https://astro.build" class="hover:text-accent">Astro</a>
    </span>
  </div>
</footer>
