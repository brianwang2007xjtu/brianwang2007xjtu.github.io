--- 
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import config from "@/config";

interface Props {
  /** Narrow container, matching the home page layout. */
  narrow?: boolean;
}

const { narrow = false } = Astro.props;

const { site } = config;
const locale = Astro.currentLocale ?? config.site.lang;

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// Exact match (used for dropdown sub-items, so only the current one highlights).
// getRelativeLocaleUrl may return a trailing slash; currentPath has it stripped.
const isExact = (path: string) => currentPath === path.replace(/\/+$/, "");

const homeHref = getRelativeLocaleUrl(locale, "");
const academicHref = getRelativeLocaleUrl(locale, "academic");
const aboutHref = getRelativeLocaleUrl(locale, "about");
const searchHref = getRelativeLocaleUrl(locale, "search");

const lifeLinks = [
  { label: "Musics", href: getRelativeLocaleUrl(locale, "musics") },
  { label: "Books", href: getRelativeLocaleUrl(locale, "books") },
  { label: "Movies", href: getRelativeLocaleUrl(locale, "movies") },
];
const lifeHref = lifeLinks[0]!.href;

const lifeActive = lifeLinks.some(l => isActive(l.href));

const blogLinks = [
  { label: "Research", href: getRelativeLocaleUrl(locale, "blog/research") },
  { label: "Daily Life", href: getRelativeLocaleUrl(locale, "blog/daily") },
  { label: "Others", href: getRelativeLocaleUrl(locale, "blog/others") },
];
const blogHref = blogLinks[0]!.href;
const blogActive = blogLinks.some(l => isActive(l.href));

const navItemClass =
  "rounded-lg px-3 py-2 text-base font-medium transition-colors hover:text-accent";
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  Skip to content
</a>

<header
  id="site-header"
  data-show="true"
  class:list={[
    narrow ? "app-layout-home" : "app-layout-wide",
    "sticky top-3 z-40 transition-[transform] duration-300",
  ]}
>
  <nav
    id="site-nav"
    class="group flex items-center justify-between rounded-2xl border border-transparent px-2 py-1.5 transition-all duration-300 [&.not-top]:border-border [&.not-top]:bg-background/70 [&.not-top]:shadow-sm [&.not-top]:backdrop-blur-xl"
  >
    <a
      href={homeHref}
      class="brand-link z-30 shrink-0 px-2 py-2 text-xl font-semibold whitespace-nowrap transition-[margin-inline-start] duration-300 group-[.not-top]:ms-3 sm:group-[.not-top]:ms-5"
    >
      {site.title}
    </a>

    <!-- Desktop navigation -->
    <ul class="hidden items-center gap-1 md:flex">
      <li class="group/drop relative">
        <a
          href={blogHref}
          class:list={[
            navItemClass,
            "inline-flex items-center gap-1",
            { "active-nav": blogActive },
          ]}
          aria-label="Nav menu item"
        >
          Blog
          <svg
            aria-hidden="true"
            class="size-3.5 transition-transform duration-200 group-hover/drop:rotate-180"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </a>
        <div
          class="invisible absolute top-full left-1/2 z-50 mt-1 w-44 -translate-x-1/2 rounded-xl border border-border bg-background/90 p-1 opacity-0 shadow-lg backdrop-blur-xl transition-all duration-150 group-hover/drop:visible group-hover/drop:opacity-100 group-focus-within/drop:visible group-focus-within/drop:opacity-100"
        >
          {
            blogLinks.map(link => (
              <a
                href={link.href}
                class:list={[
                  "block rounded-lg px-3 py-2 text-sm transition-colors hover:bg-muted hover:text-accent",
                  { "text-accent": isExact(link.href) },
                ]}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </li>
      <li>
        <a
          href={academicHref}
          class:list={[navItemClass, { "active-nav": isActive("/academic") }]}
        >
          Academic
        </a>
      </li>
      <li class="group/drop relative">
        <a
          href={lifeHref}
          class:list={[
            navItemClass,
            "inline-flex items-center gap-1",
            { "active-nav": lifeActive },
          ]}
          aria-label="Nav menu item"
        >
          Life
          <svg
            aria-hidden="true"
            class="size-3.5 transition-transform duration-200 group-hover/drop:rotate-180"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </a>
        <div
          class="invisible absolute top-full left-1/2 z-50 mt-1 w-44 -translate-x-1/2 rounded-xl border border-border bg-background/90 p-1 opacity-0 shadow-lg backdrop-blur-xl transition-all duration-150 group-hover/drop:visible group-hover/drop:opacity-100 group-focus-within/drop:visible group-focus-within/drop:opacity-100"
        >
          {
            lifeLinks.map(link => (
              <a
                href={link.href}
                class:list={[
                  "block rounded-lg px-3 py-2 text-sm transition-colors hover:bg-muted hover:text-accent",
                  { "text-accent": isActive(link.href) },
                ]}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </li>
      <li>
        <a
          href={aboutHref}
          class:list={[navItemClass, { "active-nav": isActive("/about") }]}
        >
          About
        </a>
      </li>
    </ul>

    <div class="flex items-center gap-0.5">
      <!-- Language switch -->
      <div
        id="lang-switch"
        class="flex items-center rounded-lg border border-border p-0.5"
        role="group"
        aria-label="Language"
      >
        <button
          type="button"
          data-lang="en"
          class="rounded-md px-2 py-1 text-xs font-medium transition-colors"
        >
          EN
        </button>
        <button
          type="button"
          data-lang="zh"
          class="rounded-md px-2 py-1 text-xs font-medium transition-colors"
        >
          中文
        </button>
      </div>

      <a
        href={searchHref}
        class:list={[
          "hidden rounded-lg p-2 transition-colors hover:text-accent sm:inline-flex",
          { "active-nav": isActive("/search") },
        ]}
        title="Search"
        aria-label="Search"
      >
        <IconSearch class="size-5" />
      </a>
      <button
        id="theme-btn"
        class="hover:[&>svg]:stroke-accent relative size-10 p-2.5"
        title="Toggle theme"
        aria-label="auto"
        aria-live="polite"
      >
        <IconMoon class="absolute top-[50%] left-[50%] translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
        <IconSunHigh class="absolute top-[50%] left-[50%] translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
      </button>
      <button
        id="menu-btn"
        class="focus-outline p-2 md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <IconX id="close-icon" class="hidden size-5" />
        <IconMenuDeep id="menu-icon" class="size-5" />
      </button>
    </div>
  </nav>

  <!-- Mobile menu (axi404-style expanded overlay) -->
  <div
    id="mobile-menu"
    class="invisible absolute inset-x-0 top-full mt-2 rounded-2xl border border-border bg-background/90 p-2 opacity-0 shadow-lg backdrop-blur-xl transition-all duration-200 pointer-events-none md:hidden"
  >
    <p class="px-3 pt-3 pb-1 text-xs font-semibold tracking-wide text-muted-foreground uppercase">
      Blog
    </p>
    {
      blogLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            "block rounded-lg px-3 py-2 ps-6 text-sm hover:bg-muted hover:text-accent",
            { "text-accent": isExact(link.href) },
          ]}
        >
          {link.label}
        </a>
      ))
    }
    <a href={academicHref} class:list={["block rounded-lg px-3 py-2 text-base font-medium hover:bg-muted hover:text-accent", { "text-accent": isActive("/academic") }]}>Academic</a>
    <p class="px-3 pt-3 pb-1 text-xs font-semibold tracking-wide text-muted-foreground uppercase">
      Life
    </p>
    {
      lifeLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            "block rounded-lg px-3 py-2 ps-6 text-sm hover:bg-muted hover:text-accent",
            { "text-accent": isActive(link.href) },
          ]}
        >
          {link.label}
        </a>
      ))
    }
    <a href={aboutHref} class:list={["block rounded-lg px-3 py-2 text-base font-medium hover:bg-muted hover:text-accent", { "text-accent": isActive("/about") }]}>About</a>
    <a href={searchHref} class:list={["block rounded-lg px-3 py-2 text-base font-medium hover:bg-muted hover:text-accent sm:hidden", { "text-accent": isActive("/search") }]}>Search</a>
  </div>
</header>

<script>
  function initHeader() {
    const header = document.querySelector("#site-header");
    const nav = document.querySelector("#site-nav");
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");
    let lastY = window.scrollY || document.documentElement.scrollTop;

    const onScroll = () => {
      const y = window.scrollY || document.documentElement.scrollTop;
      nav?.classList.toggle("not-top", y > 20);
      // axi404 logic: hide when scrolling down past 600px, show when scrolling up.
      header?.setAttribute(
        "data-show",
        (y < 600 || y < lastY).toString()
      );
      lastY = y;
    };
    onScroll();
    // rAF-throttled, passive — same as axi404.
    let raf: number | undefined;
    window.addEventListener(
      "scroll",
      () => {
        if (raf === undefined) {
          raf = requestAnimationFrame(() => {
            raf = undefined;
            onScroll();
          });
        }
      },
      { passive: true }
    );

    const toggleMenu = () => {
      if (!menuBtn) return;
      const open = header?.classList.toggle("expanded") ?? false;
      menuBtn.setAttribute("aria-expanded", String(open));
      menuBtn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      menuIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
    };
    menuBtn?.addEventListener("click", toggleMenu);

    return () => {
      window.removeEventListener("scroll", onScroll);
      menuBtn?.removeEventListener("click", toggleMenu);
    };
  }

  function initLangSwitch() {
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("#lang-switch [data-lang]")
    );
    if (buttons.length === 0) return () => {};

    const apply = (lang: string) => {
      document.documentElement.setAttribute(
        "lang",
        lang === "zh" ? "zh-CN" : "en"
      );
      for (const btn of buttons) {
        const active = btn.dataset.lang === lang;
        btn.classList.toggle("bg-muted", active);
        btn.classList.toggle("text-accent", active);
      }
    };

    apply(localStorage.getItem("lang") ?? "en");

    const onClick = (e: Event) => {
      const lang = (e.currentTarget as HTMLElement).dataset.lang;
      if (!lang) return;
      localStorage.setItem("lang", lang);
      apply(lang);
    };
    for (const btn of buttons) btn.addEventListener("click", onClick);

    return () => {
      for (const btn of buttons) btn.removeEventListener("click", onClick);
    };
  }

  let cleanupHeader: (() => void) | undefined;
  let cleanupLang: (() => void) | undefined;
  document.addEventListener("astro:page-load", () => {
    cleanupHeader?.();
    cleanupLang?.();
    cleanupHeader = initHeader();
    cleanupLang = initLangSwitch();
  });
</script>

<style>
  /* axi404-style header behavior:
     - on desktop, when scrolled the nav shrinks into a floating pill
     - when scrolling down past 600px the header slides away; scrolling up
       brings it back (unless the mobile menu is expanded) */
  #site-header[data-show="false"]:not(.expanded) {
    transform: translateY(-5rem);
  }

  @media (min-width: 768px) {
    #site-nav.not-top {
      margin-inline: 8%;
    }
  }

  @media (max-width: 767px) {
    #site-header.expanded #mobile-menu {
      visibility: visible;
      pointer-events: auto;
      opacity: 1;
    }
  }
</style>
