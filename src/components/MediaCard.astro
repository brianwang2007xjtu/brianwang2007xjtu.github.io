---
type IconName = "music" | "book" | "film";

type Props = {
  title: string;
  subtitle: string;
  description: string;
  cover?: string;
  icon?: IconName;
  badge?: string;
  action?: { label: string; href: string };
};

const {
  title,
  subtitle,
  description,
  cover,
  icon = "music",
  badge,
  action,
} = Astro.props;

// Deterministic gradient placeholder derived from the title.
function hashHue(str: string): number {
  let h = 0;
  for (let i = 0; i < str.length; i++) {
    h = (h * 31 + str.charCodeAt(i)) % 360;
  }
  return h;
}

const hue = hashHue(title);
const gradient = `linear-gradient(135deg, hsl(${hue} 55% 58%), hsl(${(hue + 70) % 360} 55% 42%))`;
---

<article
  class="group flex gap-4 rounded-2xl border border-border bg-background p-4 transition-colors duration-300 hover:bg-muted sm:p-5"
>
  <div class="h-24 w-24 shrink-0 overflow-hidden rounded-xl border border-border sm:h-28 sm:w-28">
    {
      cover ? (
        <img
          src={cover}
          alt={`${title} cover`}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div
          class="flex h-full w-full items-center justify-center"
          style={`background-image: ${gradient}`}
        >
          {
            icon === "music" && (
              <svg
                class="size-10 text-white/90"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M9 18V5l12-2v13"></path>
                <circle cx="6" cy="18" r="3"></circle>
                <circle cx="18" cy="16" r="3"></circle>
              </svg>
            )
          }
          {
            icon === "book" && (
              <svg
                class="size-10 text-white/90"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0"></path>
                <path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0"></path>
                <path d="M3 6v13"></path>
                <path d="M12 6v13"></path>
                <path d="M21 6v13"></path>
              </svg>
            )
          }
          {
            icon === "film" && (
              <svg
                class="size-10 text-white/90"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                <path d="M8 4v16"></path>
                <path d="M16 4v16"></path>
                <path d="M4 8h4"></path>
                <path d="M4 16h4"></path>
                <path d="M4 12h16"></path>
                <path d="M20 8h-4"></path>
                <path d="M20 16h-4"></path>
              </svg>
            )
          }
        </div>
      )
    }
  </div>

  <div class="min-w-0 flex-1">
    <div class="flex items-start justify-between gap-2">
      <h3 class="truncate font-medium transition-colors group-hover:text-accent">
        {title}
      </h3>
      {badge && (
        <span
          class="rounded-full border border-border bg-muted px-2.5 py-0.5 text-xs whitespace-nowrap text-muted-foreground"
        >
          {badge}
        </span>
      )}
    </div>
    <p class="mt-0.5 truncate text-sm text-muted-foreground">{subtitle}</p>
    <p class="mt-1 line-clamp-2 text-sm text-muted-foreground/80">
      {description}
    </p>
    {
      action && (
        <a
          href={action.href}
          class="mt-3 inline-flex items-center gap-1.5 rounded-lg border border-border bg-muted px-3 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:border-accent/40 hover:text-accent"
        >
          <svg
            class="size-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"></path>
            <path d="M7 11l5 5 5 -5"></path>
            <path d="M12 4v12"></path>
          </svg>
          {action.label}
        </a>
      )
    }
  </div>
</article>
