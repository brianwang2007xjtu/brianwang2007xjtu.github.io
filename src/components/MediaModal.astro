---
---

<div
  id="media-modal"
  class="fixed inset-0 z-[60] hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="media-modal-title"
>
  <div
    id="media-modal-backdrop"
    class="absolute inset-0 bg-black/50 backdrop-blur-sm"
  ></div>
  <div
    class="relative z-10 flex max-h-[88dvh] w-full max-w-xl flex-col overflow-hidden rounded-2xl border border-border bg-background shadow-2xl"
  >
    <button
      type="button"
      id="media-modal-close"
      aria-label="Close"
      class="absolute top-3 end-3 z-10 rounded-full border border-border bg-background/80 p-1.5 text-muted-foreground backdrop-blur transition-colors hover:text-accent"
    >
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>

    <div
      id="media-modal-cover"
      class="flex h-40 w-full shrink-0 items-center justify-center overflow-hidden"
    ></div>

    <div class="overflow-y-auto p-5 pt-4">
      <div class="flex items-start justify-between gap-2">
        <h3 id="media-modal-title" class="text-lg font-medium leading-snug"></h3>
        <span
          id="media-modal-badge"
          class="hidden shrink-0 rounded-full border border-border bg-muted px-2.5 py-0.5 text-xs whitespace-nowrap text-muted-foreground"
        ></span>
      </div>
      <p
        id="media-modal-subtitle"
        class="mt-1 text-sm leading-relaxed text-muted-foreground"
      ></p>

      <div
        id="media-modal-meta"
        class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3 border-t border-border pt-4"
      ></div>

      <div id="media-modal-quote" class="mt-4 hidden">
        <div
          id="media-modal-quote-label"
          class="text-xs font-semibold uppercase tracking-wide text-muted-foreground"
        ></div>
        <blockquote
          id="media-modal-quote-text"
          class="mt-1 border-s-2 border-accent/60 ps-3 text-sm italic text-muted-foreground"
        ></blockquote>
      </div>

      <div id="media-modal-sections" class="mt-4 space-y-4"></div>
    </div>
  </div>
</div>

<script>
  const ICONS: Record<string, string> = {
    music:
      '<svg class="size-12 text-white/90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>',
    book:
      '<svg class="size-12 text-white/90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0"></path><path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0"></path><path d="M3 6v13"></path><path d="M12 6v13"></path><path d="M21 6v13"></path></svg>',
    film:
      '<svg class="size-12 text-white/90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"></rect><path d="M8 4v16"></path><path d="M16 4v16"></path><path d="M4 8h4"></path><path d="M4 16h4"></path><path d="M4 12h16"></path><path d="M20 8h-4"></path><path d="M20 16h-4"></path></svg>',
  };

  function initMediaModal() {
    const modal = document.getElementById("media-modal");
    if (!modal) return () => {};
    const el = modal;

    const titleEl = modal.querySelector("#media-modal-title");
    const subtitleEl = modal.querySelector("#media-modal-subtitle");
    const badgeEl = modal.querySelector("#media-modal-badge");
    const coverEl = modal.querySelector("#media-modal-cover");
    const metaEl = modal.querySelector<HTMLElement>("#media-modal-meta");
    const quoteEl = modal.querySelector("#media-modal-quote");
    const quoteLabelEl = modal.querySelector("#media-modal-quote-label");
    const quoteTextEl = modal.querySelector("#media-modal-quote-text");
    const sectionsEl = modal.querySelector<HTMLElement>("#media-modal-sections");

    function make(
      tag: string,
      className: string,
      text?: string
    ): HTMLElement {
      const e = document.createElement(tag);
      if (className) e.className = className;
      if (text !== undefined) e.textContent = text;
      return e;
    }

    function open(card: HTMLElement) {
      let d: Record<string, unknown> = {};
      try {
        d = JSON.parse(card.dataset.detail || "{}");
      } catch {
        d = {};
      }

      const title = (d.title as string) ?? "";
      const subtitle = (d.subtitle as string) ?? "";
      const badge = (d.badge as string) ?? "";
      const icon = (d.icon as string) ?? "music";
      const gradient = (d.gradient as string) ?? "";
      const cover = (d.cover as string) ?? "";
      const meta = (d.meta as Array<{ label: string; value: string }>) ?? [];
      const quote = d.quote as { label?: string; text?: string } | null;
      const sections =
        (d.sections as Array<{ label: string; body: string }>) ?? [];

      if (titleEl) titleEl.textContent = title;
      if (subtitleEl) subtitleEl.textContent = subtitle;
      if (badgeEl) {
        if (badge) {
          badgeEl.textContent = badge;
          badgeEl.classList.remove("hidden");
        } else {
          badgeEl.classList.add("hidden");
        }
      }
      if (coverEl) {
        coverEl.innerHTML = cover
          ? `<img src="${cover}" alt="" class="h-full w-full object-cover" />`
          : `<div class="flex h-full w-full items-center justify-center" style="background-image:${gradient}">${ICONS[icon] ?? ICONS.music}</div>`;
      }

      if (metaEl) {
        metaEl.replaceChildren();
        metaEl.style.display = meta.length ? "" : "none";
        for (const m of meta) {
          const item = document.createElement("div");
          item.appendChild(
            make(
              "div",
              "text-xs font-semibold uppercase tracking-wide text-muted-foreground",
              m.label
            )
          );
          item.appendChild(make("div", "mt-0.5 text-sm", m.value));
          metaEl.appendChild(item);
        }
      }

      if (quoteEl && quoteLabelEl && quoteTextEl) {
        if (quote && quote.text) {
          quoteEl.classList.remove("hidden");
          quoteLabelEl.textContent = quote.label ?? "";
          quoteTextEl.textContent = quote.text;
        } else {
          quoteEl.classList.add("hidden");
        }
      }

      if (sectionsEl) {
        sectionsEl.replaceChildren();
        sectionsEl.style.display = sections.length ? "" : "none";
        for (const s of sections) {
          const wrap = document.createElement("div");
          wrap.appendChild(make("h4", "text-sm font-semibold", s.label));
          wrap.appendChild(
            make(
              "p",
              "mt-1 text-sm leading-relaxed text-muted-foreground",
              s.body
            )
          );
          sectionsEl.appendChild(wrap);
        }
      }

      el.classList.remove("hidden");
      el.classList.add("flex");
      document.body.style.overflow = "hidden";
    }

    function close() {
      el.classList.add("hidden");
      el.classList.remove("flex");
      document.body.style.overflow = "";
    }

    const onCardClick = (e: Event) => {
      const target = e.target as HTMLElement;
      if (target.closest("[data-media-action]")) return;
      const card = target.closest<HTMLElement>("[data-media-card]");
      if (card) open(card);
    };

    const onCardKey = (e: KeyboardEvent) => {
      if (e.key !== "Enter" && e.key !== " ") return;
      const target = e.target as HTMLElement;
      if (target.closest("[data-media-action]")) return;
      const card = target.closest<HTMLElement>("[data-media-card]");
      if (card) {
        e.preventDefault();
        open(card);
      }
    };

    const onEscape = (e: KeyboardEvent) => {
      if (e.key === "Escape") close();
    };

    document.addEventListener("click", onCardClick);
    document.addEventListener("keydown", onCardKey);
    document.addEventListener("keydown", onEscape);
    modal
      .querySelector("#media-modal-close")
      ?.addEventListener("click", close);
    modal
      .querySelector("#media-modal-backdrop")
      ?.addEventListener("click", close);

    return () => {
      document.removeEventListener("click", onCardClick);
      document.removeEventListener("keydown", onCardKey);
      document.removeEventListener("keydown", onEscape);
    };
  }

  let cleanup: (() => void) | undefined;
  document.addEventListener("astro:page-load", () => {
    cleanup?.();
    cleanup = initMediaModal();
  });
</script>
