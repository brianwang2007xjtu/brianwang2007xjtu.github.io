---
import type { PaperNode } from "@/utils/getPaperGraph";
import { GRAPH_ROOT } from "@/data/paperGraphMeta";
import { paperLabelToText, isLatexLabel } from "@/utils/paperLabel";

interface Props {
  papers: PaperNode[];
  /** 画布高度（px），默认 520。 */
  height?: number;
}

const { papers, height = 520 } = Astro.props;

const years = [...new Set(papers.map(p => p.year).filter(Boolean))]
  .map(Number)
  .sort((a, b) => b - a);

/** 列表视图按 一级 → 二级 分类分组 */
const tree: {
  branch: string;
  leaves: { leaf: string; items: PaperNode[] }[];
}[] = [];
for (const paper of papers) {
  let branch = tree.find(b => b.branch === paper.branch);
  if (!branch) {
    branch = { branch: paper.branch, leaves: [] };
    tree.push(branch);
  }
  let leaf = branch.leaves.find(l => l.leaf === paper.leaf);
  if (!leaf) {
    leaf = { leaf: paper.leaf, items: [] };
    branch.leaves.push(leaf);
  }
  leaf.items.push(paper);
}
tree.sort(
  (a, b) =>
    b.leaves.reduce((n, l) => n + l.items.length, 0) -
    a.leaves.reduce((n, l) => n + l.items.length, 0)
);
---

<section class="paper-graph mt-10" data-paper-graph>
  <h2 class="pg-title">Paper Graph</h2>

  <div class="pg-toolbar">
    <div class="pg-years" data-pg-years>
      <span class="pg-toolbar-label">Year</span>
      <button
        type="button"
        class="pg-chip"
        data-pg-year="all"
        aria-pressed="true"
      >
        All
        <span class="pg-chip-count">{papers.length}</span>
      </button>
      {
        years.slice(0, 3).map(year => (
          <button
            type="button"
            class="pg-chip"
            data-pg-year={year}
            aria-pressed="false"
          >
            {year}
            <span class="pg-chip-count">
              {papers.filter(p => p.year === year).length}
            </span>
          </button>
        ))
      }
      {
        years.length > 3 && (
          <>
            <button
              type="button"
              class="pg-chip pg-chip-more"
              data-pg-year-more
              aria-expanded="false"
              aria-label="More years"
            >
              ···
            </button>
            {years.slice(3).map(year => (
              <button
                type="button"
                class="pg-chip"
                data-pg-year={year}
                aria-pressed="false"
                hidden
              >
                {year}
                <span class="pg-chip-count">
                  {papers.filter(p => p.year === year).length}
                </span>
              </button>
            ))}
          </>
        )
      }
    </div>

    <div class="pg-tools">
      <input
        class="pg-search"
        type="search"
        placeholder="Search papers…"
        aria-label="Search papers"
        data-pg-search
      />
      <div class="pg-buttons" role="group" aria-label="View controls">
        <button type="button" data-pg-zoom="in" aria-label="Zoom in">+</button>
        <button type="button" data-pg-zoom="out" aria-label="Zoom out">−</button>
        <button type="button" data-pg-reset aria-label="Reset view">Reset</button>
        <button type="button" data-pg-toggle aria-pressed="false">List</button>
      </div>
    </div>
  </div>

  <div class="pg-stage" style={`--pg-height:${height}px`} data-pg-stage>
    <canvas data-pg-canvas tabindex="0" aria-label="Paper relationship graph"></canvas>

    <div class="pg-card" data-pg-card hidden>
      <div class="pg-card-media">
        <img data-pg-card-img alt="" loading="lazy" />
        <span class="pg-card-media-empty" data-pg-card-noimg>暂无配图</span>
      </div>
      <div class="pg-card-body">
        <p class="pg-card-name" data-pg-card-name></p>
        <p class="pg-card-meta">
          <span class="pg-card-year" data-pg-card-year></span>
          <span class="pg-card-branch" data-pg-card-branch></span>
        </p>
        <p class="pg-card-summary" data-pg-card-summary></p>
        <p class="pg-card-group" data-pg-card-group></p>
      </div>
    </div>

    <p class="pg-hint-mobile">Pinch to zoom · drag to pan · tap a node</p>
  </div>

  <ul class="pg-list" data-pg-list hidden>
    {
      papers.map(paper => (
        <li data-list-year={paper.year ?? ""}>
          <a href={paper.href}>
            <span class="pg-list-name" data-latex={paper.label}>
              {paperLabelToText(paper.label)}
            </span>
            <span class="pg-list-meta">{paper.year ?? ""}</span>
            <span class="pg-list-group">{paper.branch} / {paper.leaf}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <script
    type="application/json"
    id="paper-graph-data"
    set:html={JSON.stringify({ papers, root: GRAPH_ROOT })}
  />
</section>

<style>
