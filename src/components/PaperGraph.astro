  .pg-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    margin: 0.7rem 0 0.85rem;
  }

  .pg-years {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem;
