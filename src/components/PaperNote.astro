---
type Props = {
  title: string;
  arxivId: string;
  noteUrl: string;
  summary: string;
  images?: string[];
};

const { title, arxivId, noteUrl, summary, images = [] } = Astro.props;
---

<div class="my-6 rounded-xl border border-border bg-background/50 p-4 sm:p-6">
  <p class="flex items-start gap-2 text-sm text-muted-foreground">
    <svg
      class="mt-0.5 size-4 shrink-0 text-accent"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 8h.01"></path>
      <path d="M11 12h1v4h1"></path>
    </svg>
    <span>{summary}</span>
  </p>

  <div class="mt-4 space-y-4">
    {
      images.map(src => (
        <img
          src={src}
          alt={`${title} 截图`}
          class="w-full rounded-lg border border-border"
          loading="lazy"
        />
      ))
    }
    <slot />
  </div>

  <div class="mt-5 flex flex-wrap items-center gap-3 border-t border-border pt-4">
    <a
      href={`https://arxiv.org/abs/${arxivId}`}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full border border-border pe-3 transition-colors hover:border-accent/40"
    >
      <span class="rounded-full bg-muted px-2.5 py-1 text-xs font-medium text-muted-foreground">
        Arxiv ID
      </span>
      <samp class="break-all text-sm text-foreground">{arxivId}</samp>
    </a>

    <a
      href={noteUrl}
      download
      class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 pe-3 transition-colors hover:bg-blue-100"
    >
      <span class="rounded-full bg-blue-100 px-2.5 py-1 text-xs font-medium text-blue-700">
        笔记下载
      </span>
      <svg
        class="size-4 text-blue-700"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 3v12"></path>
        <path d="m7 10 5 5 5-5"></path>
        <path d="M5 21h14"></path>
      </svg>
    </a>
  </div>
</div>
