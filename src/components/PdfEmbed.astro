---
type Props = { src: string; title: string; label?: string };

const { src, title, label = "Download" } = Astro.props;
---

<div class="my-6">
  <iframe
    src={src}
    title={title}
    class="h-[70vh] w-full rounded-xl border border-border bg-muted/30"
    loading="lazy"
  />
  <a
    href={src}
    download
    class="mt-3 inline-flex items-center gap-1.5 rounded-lg border border-border bg-muted px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:border-accent/40 hover:text-accent"
  >
    <svg
      class="size-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 3v12"></path>
      <path d="m7 10 5 5 5-5"></path>
      <path d="M5 21h14"></path>
    </svg>
    {label}
  </a>
</div>
