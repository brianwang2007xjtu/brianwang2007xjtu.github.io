---
type GridImage = {
  src: string;
  alt?: string;
  /** Hover text shown next to the cursor. */
  label?: string;
  /** Target page for this cell; falls back to `defaultHref`. */
  href?: string;
};

interface Props {
  /** The images to show (renders in a 3-column grid). */
  images?: GridImage[];
  /** Default destination for cells without their own `href`. */
  defaultHref?: string;
  /** Black & white by default, fades to color on hover (like the original). */
  grayscale?: boolean;
  /** Wrap cells in links (click to navigate). */
  links?: boolean;
  /** Show the label bubble that follows the cursor. */
  tooltip?: boolean;
}

const {
  images,
  defaultHref = "/",
  grayscale = false,
  links = true,
  tooltip = true,
} = Astro.props;

// Placeholder set when no images are passed (swap via the `images` prop).
const DEFAULT_ITEMS: GridImage[] = [
  { src: "https://picsum.photos/seed/oxford-1/600/600", alt: "placeholder-1", label: "图片 1", href: defaultHref },
  { src: "https://picsum.photos/seed/oxford-2/600/600", alt: "placeholder-2", label: "图片 2", href: defaultHref },
  { src: "https://picsum.photos/seed/oxford-3/600/600", alt: "placeholder-3", label: "图片 3", href: defaultHref },
];

const items: GridImage[] = images && images.length > 0 ? images : DEFAULT_ITEMS;
---

<div class:list={["photo-grid", { "is-grayscale": grayscale }]} data-photo-grid>
  {
    items.map((img, i) => {
      const cellAttrs = {
        class: "photo-cell group",
        "data-label": img.label ?? `图片 ${i + 1}`,
        "aria-label": img.alt ?? img.label ?? `图片 ${i + 1}`,
      };
      return links ? (
        <a href={img.href ?? defaultHref} {...cellAttrs}>
          <img src={img.src} alt={img.alt ?? ``} loading="lazy" />
        </a>
      ) : (
        <div {...cellAttrs}>
          <img src={img.src} alt={img.alt ?? ``} loading="lazy" />
        </div>
      );
    })
  }
</div>
{
  tooltip && (
    <div class="photo-tooltip" data-photo-tooltip aria-hidden="true"></div>
  )
}

<script>
  // Label bubble that follows the cursor while hovering a cell.
  document.addEventListener("astro:page-load", () => {
    const grid = document.querySelector<HTMLElement>("[data-photo-grid]");
    const tip = document.querySelector<HTMLElement>("[data-photo-tooltip]");
    if (!grid || !tip) return;

    const hide = () => {
      tip.classList.remove("visible");
      tip.textContent = "";
    };

    grid.addEventListener("mousemove", e => {
      const cell = (e.target as HTMLElement).closest<HTMLElement>(".photo-cell");
      if (!cell) {
        hide();
        return;
      }
      tip.textContent = cell.dataset.label ?? "";
      tip.classList.add("visible");
      const pad = 12;
      const w = tip.offsetWidth;
      const h = tip.offsetHeight;
      let left = e.clientX + pad + 4;
      let top = e.clientY + pad + 4;
      if (left + w > window.innerWidth - 8) left = e.clientX - w - pad;
      if (top + h > window.innerHeight - 8) top = e.clientY - h - pad;
      tip.style.left = `${left}px`;
      tip.style.top = `${top}px`;
    });

    grid.addEventListener("mouseleave", hide);
  });
</script>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.375rem;
    width: 100%;
    margin: 1.25rem 0;
  }

  .photo-cell {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0.5rem;
    background: var(--muted);
  }

  /* Original colors; no borders/margins from the article prose styles, and
     any source aspect ratio is auto-cropped to the square cell. */
  .photo-grid .photo-cell img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    border: 0;
    object-fit: cover;
    transform: scale(1);
    transition: transform 0.3s ease;
  }

  .photo-grid .photo-cell:hover img {
    transform: scale(1.05);
  }

  /* Classic effect: grayscale by default, color fades in on hover. */
  .photo-grid.is-grayscale .photo-cell img {
    filter: grayscale(1);
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .photo-grid.is-grayscale .photo-cell:hover img {
    filter: grayscale(0);
  }

  .photo-cell:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .photo-tooltip {
    position: fixed;
    z-index: 60;
    pointer-events: none;
    display: inline-block;
    max-width: 16rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: color-mix(in oklab, var(--background) 94%, transparent);
    backdrop-filter: blur(6px);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--foreground);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .photo-tooltip.visible {
    opacity: 1;
  }
</style>
