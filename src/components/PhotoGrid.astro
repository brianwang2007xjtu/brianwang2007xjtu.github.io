---
type GridImage = {
  src: string;
  alt?: string;
  /** Hover text shown next to the cursor. */
  label?: string;
  /** Target blog post; falls back to `defaultHref`. */
  href?: string;
};

interface Props {
  /** Exactly the images to show (any count; renders in a 3-column grid). */
  images?: GridImage[];
  /** Default destination for cells without their own `href`. */
  defaultHref?: string;
}

const {
  images,
  defaultHref = "/",
} = Astro.props;

// Placeholder set — every image has its OWN hover text and its OWN
// destination, so the grid behaves correctly before the real photos,
// captions and links are filled in (edit the `images` prop of the usage
// site, e.g. in the blog post, to replace them).
const DEFAULT_ITEMS: GridImage[] = [
  { src: "https://picsum.photos/seed/oxford-1/600/600", alt: "placeholder-1", label: "图片 1", href: "/posts/diffusion-model-math/" },
  { src: "https://picsum.photos/seed/oxford-2/600/600", alt: "placeholder-2", label: "图片 2", href: "/posts/paper-reading-diffusion-models/" },
  { src: "https://picsum.photos/seed/oxford-3/600/600", alt: "placeholder-3", label: "图片 3", href: "/posts/paper-reading-fundamental-popular-works/" },
  { src: "https://picsum.photos/seed/oxford-4/600/600", alt: "placeholder-4", label: "图片 4", href: "/posts/lhm-oxford-summary-intro/" },
  { src: "https://picsum.photos/seed/oxford-5/600/600", alt: "placeholder-5", label: "图片 5", href: "/posts/template-all-features/" },
  { src: "https://picsum.photos/seed/oxford-6/600/600", alt: "placeholder-6", label: "图片 6", href: "/blog/research/" },
  { src: "https://picsum.photos/seed/oxford-7/600/600", alt: "placeholder-7", label: "图片 7", href: "/blog/daily/" },
  { src: "https://picsum.photos/seed/oxford-8/600/600", alt: "placeholder-8", label: "图片 8", href: "/archives/" },
  { src: "https://picsum.photos/seed/oxford-9/600/600", alt: "placeholder-9", label: "图片 9", href: "/about/" },
];

const items: GridImage[] = images && images.length > 0 ? images : DEFAULT_ITEMS;
---

<div class="photo-grid" data-photo-grid>
  {items.map((img, i) => (
    <a
      href={img.href ?? defaultHref}
      class="photo-cell group"
      data-label={img.label ?? `图片 ${i + 1}`}
      aria-label={img.alt ?? img.label ?? `图片 ${i + 1}`}
    >
      <img src={img.src} alt={img.alt ?? ``} loading="lazy" />
    </a>
  ))}
</div>
<div class="photo-tooltip" data-photo-tooltip aria-hidden="true"></div>

<script>
  // Label that follows the cursor while hovering a cell (GitHub-style tooltip).
  document.addEventListener("astro:page-load", () => {
    const grid = document.querySelector<HTMLElement>("[data-photo-grid]");
    const tip = document.querySelector<HTMLElement>("[data-photo-tooltip]");
    if (!grid || !tip) return;

    const hide = () => {
      tip.classList.remove("visible");
      tip.textContent = "";
    };

    grid.addEventListener("mousemove", e => {
      const cell = (e.target as HTMLElement).closest<HTMLElement>(".photo-cell");
      if (!cell) {
        hide();
        return;
      }
      tip.textContent = cell.dataset.label ?? "";
      tip.classList.add("visible");
      tip.style.left = "0px";
      tip.style.top = "0px";
      const pad = 12;
      const w = tip.offsetWidth;
      const h = tip.offsetHeight;
      let left = e.clientX + pad + 4;
      let top = e.clientY + pad + 4;
      if (left + w > window.innerWidth - 8) left = e.clientX - w - pad;
      if (top + h > window.innerHeight - 8) top = e.clientY - h - pad;
      tip.style.left = `${left}px`;
      tip.style.top = `${top}px`;
    });

    grid.addEventListener("mouseleave", hide);
  });
</script>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.375rem;
    width: 100%;
    margin: 1.25rem 0;
  }

  .photo-cell {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0.5rem;
    background: var(--muted);
  }

  /* No extra borders/margins from the article prose styles, and any source
     aspect ratio is auto-cropped to the square cell. */
  .photo-grid .photo-cell img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    border: 0;
    object-fit: cover;
    /* Black & white first; color + slight zoom on hover. */
    filter: grayscale(1);
    transform: scale(1);
    transition: filter 0.3s ease, transform 0.3s ease;
  }

  .photo-grid .photo-cell:hover img,
  .photo-grid .photo-cell:focus-visible img {
    filter: grayscale(0);
    transform: scale(1.05);
  }

  .photo-cell:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .photo-tooltip {
    position: fixed;
    z-index: 60;
    pointer-events: none;
    display: inline-block;
    max-width: 16rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: color-mix(in oklab, var(--background) 94%, transparent);
    backdrop-filter: blur(6px);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--foreground);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .photo-tooltip.visible {
    opacity: 1;
  }
</style>
