---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

type Props = CollectionEntry<"posts"> & {
  /** Show the per-article reading-progress indicator (Blog listing page). */
  trackProgress?: boolean;
};

const {
  id,
  data,
  body,
  filePath,
  trackProgress = false,
} = Astro.props;
const { title, description, pubDatetime, tags = [] } = data;

const locale = Astro.currentLocale ?? config.site.lang;
const url = getPostUrl(id, filePath, locale);

const date = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "2-digit",
  year: "numeric",
}).format(pubDatetime);

const words = (body ?? "").split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.ceil(words / 200));

const visibleTags = tags.slice(0, 3);
---

<li
  data-reading-card
  data-reading-title={title}
  class="group relative flex flex-col gap-3 rounded-2xl border border-border bg-background px-5 py-4 transition-colors duration-300 hover:bg-muted sm:px-6 sm:py-5"
>
  <a href={url} class="flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1">
      <span class="font-mono text-xs text-muted-foreground">{date}</span>
      <h2 class="mt-1 font-medium transition-colors group-hover:text-accent">
        {title}
      </h2>
      <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">
        {description}
      </p>
      <p class="mt-2 text-xs italic text-muted-foreground">{minutes} min read</p>
    </div>
    {
      trackProgress && (
        <div class="flex shrink-0 flex-col items-end gap-1.5 pt-1">
          <span
            data-reading-percent
            class="text-sm font-semibold tabular-nums text-accent"
          >
            0%
          </span>
          <div class="h-1 w-14 overflow-hidden rounded-full bg-muted">
            <div
              data-reading-bar
              class="h-full w-0 rounded-full bg-accent transition-[width] duration-150"
            ></div>
          </div>
        </div>
      )
    }
  </a>

  {
    visibleTags.length > 0 && (
      <ul class="flex flex-wrap gap-2">
        {
          visibleTags.map(tag => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, `tags/${slugifyStr(tag)}`)}
                class="rounded-full border border-border bg-muted px-3 py-1 text-xs font-medium text-muted-foreground transition-colors hover:border-foreground/20 hover:text-foreground"
              >
                {tag}
              </a>
            </li>
          ))
        }
      </ul>
    )
  }
</li>
