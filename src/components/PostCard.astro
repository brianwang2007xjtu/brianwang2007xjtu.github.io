---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import { countWords } from "@/utils/getBlogStats";
import { walineServerURL } from "@/data/waline";
import config from "@/config";
import { getPostCover } from "@/utils/postCover";

type Props = CollectionEntry<"posts">;

const { id, data, body, filePath } = Astro.props;
const { title, description, pubDatetime, tags = [] } = data;

const locale = Astro.currentLocale ?? config.site.lang;
const url = getPostUrl(id, filePath, locale);
const viewPath = url;
const viewsEnabled = walineServerURL.trim() !== "";

// 列表里的日期也要按站点时区（Asia/Shanghai）显示，否则跨零点时会和文章页差一天
const date = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "2-digit",
  year: "numeric",
  timeZone: config.site.timezone,
}).format(pubDatetime);

// CJK-aware word count (each Chinese char counts as one "word", Latin words
// counted normally) with markdown/code noise stripped — post body only.
const minutes = Math.max(1, Math.ceil(countWords(body ?? "") / 200));

const visibleTags = tags.slice(0, 3);

// 封面图 + 主色调（悬浮时把整张卡片染成这个颜色）
const cover = await getPostCover(body ?? "", undefined, {
  cover: data.cover,
  accent: data.accent,
});
---

<li
  class="group relative flex flex-col gap-3 overflow-hidden rounded-2xl border border-border bg-background px-5 py-4 transition-colors duration-300 sm:px-6 sm:py-5"
  style={cover ? `--card-highlight: ${cover.highlight}` : undefined}
  data-cover={cover ? "1" : undefined}
>
  {
    cover && (
      <img
        src={cover.src}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
        class="post-cover pointer-events-none absolute inset-y-0 end-0 top-0 z-0 h-2/3 w-full object-cover opacity-45 transition-opacity duration-500 group-hover:opacity-65 md:h-full md:w-3/5"
      />
    )
  }
  <div class:list={["relative z-10 flex flex-col gap-3", { "max-sm:pt-28": Boolean(cover) }]}>
  <a href={url} class="flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1">
      <span class="font-mono text-xs text-muted-foreground">{date}</span>
      <h2 class="mt-1 font-medium transition-colors group-hover:text-accent">
        {title}
      </h2>
      <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">
        {description}
      </p>
      <p class="mt-2 text-xs italic text-muted-foreground">
        {minutes} min read
        {
          viewsEnabled && (
            <>
              {" · "}
              <span class="waline-pageview-count" data-path={viewPath}>
                0
              </span>
              {" views"}
            </>
          )
        }
      </p>
    </div>
  </a>

  {
    visibleTags.length > 0 && (
      <ul class="flex flex-wrap gap-2">
        {
          visibleTags.map(tag => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, `tags/${slugifyStr(tag)}`)}
                class="rounded-full border border-border bg-muted px-3 py-1 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground"
              >
                {tag}
              </a>
            </li>
          ))
        }
      </ul>
    )
  }
  </div>
</li>

<style>
  /* 参考 Leo's Realms：封面图从右往左渐隐，只留下淡淡的底图 */
  .post-cover {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 65%);
    mask-image: linear-gradient(to right, transparent 0%, #000 65%);
  }

  @media (max-width: 640px) {
    .post-cover {
      -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 70%);
      mask-image: linear-gradient(to top, transparent 0%, #000 70%);
    }
  }

  /* 悬浮：整张卡片浮起一层封面图的主色调 */
  li[data-cover="1"]:hover {
    background-color: var(--card-highlight);
  }

  @media (prefers-reduced-motion: no-preference) {
    li[data-cover="1"] {
      transition: background-color 0.35s ease;
    }
  }
</style>
