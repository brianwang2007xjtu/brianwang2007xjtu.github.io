---
---

<div
  id="reading-widget"
  class="fixed bottom-5 end-5 z-40 hidden w-72 max-w-[calc(100vw-2.5rem)] rounded-xl border border-border bg-background/85 px-4 py-3 shadow-lg backdrop-blur-xl"
>
  <div class="flex items-center gap-3">
    <div class="min-w-0 flex-1">
      <p class="text-[11px] font-medium tracking-wide text-muted-foreground uppercase">
        Now reading
      </p>
      <p id="reading-widget-title" class="truncate text-sm font-medium">
        —
      </p>
    </div>
    <span
      id="reading-widget-percent"
      class="text-sm font-semibold tabular-nums text-accent"
    >
      0%
    </span>
  </div>
  <div class="mt-2 h-1 w-full overflow-hidden rounded-full bg-muted">
    <div
      id="reading-widget-bar"
      class="h-full w-0 rounded-full bg-accent transition-[width] duration-150"
    ></div>
  </div>
</div>

<script>
  function initReadingProgress() {
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-reading-card]")
    );
    const widget = document.getElementById("reading-widget");
    if (cards.length === 0) return () => {};

    let current: HTMLElement | null = null;
    let ticking = false;

    function update() {
      const vh = window.innerHeight;
      const st = window.scrollY;
      const center = st + vh / 2;
      let best: HTMLElement | null = null;
      let bestDist = Infinity;

      for (const card of cards) {
        const rect = card.getBoundingClientRect();
        const top = rect.top + st;
        const h = rect.height;
        const progress = Math.min(1, Math.max(0, (st - top) / h));
        const percent = Math.round(progress * 100);

        const pEl = card.querySelector("[data-reading-percent]");
        const bEl = card.querySelector<HTMLElement>("[data-reading-bar]");
        if (pEl) pEl.textContent = `${percent}%`;
        if (bEl) bEl.style.width = `${percent}%`;

        if (rect.bottom > 0 && rect.top < vh) {
          const c = top + h / 2;
          const dist = Math.abs(c - center);
          if (dist < bestDist) {
            bestDist = dist;
            best = card;
          }
        }
      }

      if (best && best !== current) {
        current = best;
        if (widget) {
          widget.classList.remove("hidden");
          const titleEl = widget.querySelector("#reading-widget-title");
          if (titleEl) titleEl.textContent = best.dataset.readingTitle ?? "";
        }
      }

      if (current && widget) {
        const rect = current.getBoundingClientRect();
        const top = rect.top + st;
        const h = rect.height;
        const progress = Math.min(1, Math.max(0, (st - top) / h));
        const percent = Math.round(progress * 100);
        const percentEl = widget.querySelector("#reading-widget-percent");
        const barEl = widget.querySelector<HTMLElement>("#reading-widget-bar");
        if (percentEl) percentEl.textContent = `${percent}%`;
        if (barEl) barEl.style.width = `${percent}%`;
      }
    }

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();

    return () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
    };
  }

  let cleanup: (() => void) | undefined;
  document.addEventListener("astro:page-load", () => {
    cleanup?.();
    cleanup = initReadingProgress();
  });
</script>
