---
import config from "@/config";

const { site, socials } = config;

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

const labelMap: Record<string, string> = {
  github: "GitHub",
  mail: "Email",
  bilibili: "Bilibili",
  x: "X",
  linkedin: "LinkedIn",
  facebook: "Facebook",
  telegram: "Telegram",
  whatsapp: "WhatsApp",
  pinterest: "Pinterest",
};

const items = await Promise.all(
  socials.map(async ({ name, url, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;
    const isMail = url.startsWith("mailto:") || name === "mail";
    const title =
      linkTitle ??
      (isMail
        ? `Send an email to ${site.title}`
        : `${site.title} on ${labelMap[name] ?? name}`);
    return { name, url, title, Icon, label: labelMap[name] ?? name };
  })
);
---

<div class="flex flex-wrap items-center gap-2">
  {
    items.map(({ url, title, Icon, label }) =>
      Icon ? (
        <a
          href={url}
          title={title}
          class="group relative flex items-center gap-2 rounded-lg border border-border/60 bg-gradient-to-r from-muted/80 via-muted/60 to-muted/80 px-3 py-2 text-sm font-medium text-muted-foreground backdrop-blur-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:text-accent hover:shadow-md hover:shadow-accent/10"
        >
          <Icon class="size-4 shrink-0" />
          <span>{label}</span>
          <span class="sr-only">{title}</span>
        </a>
      ) : null
    )
  }
</div>
