---
/**
 * Paper-style theorem box: bold upright label ("Theorem 1.") followed by the
 * statement in italic serif, on a highlighted background — like theorems are
 * typeset in papers.
 *
 * Usage (in MDX):
 *   <Theorem number={1}>
 *     Given vector fields $u_t(x|x_1)$ that generate conditional probability
 *     paths $p_t(x|x_1)$, for any distribution $q(x_1)$, ...
 *   </Theorem>
 *
 * A display equation written right after the box (`$$ ... $$`) continues the
 * statement, as in papers. `$...$` math inside is rendered by MathRenderer.
 */
interface Props {
  /** Theorem number, e.g. 1 → "Theorem 1." Omit for an unnumbered label. */
  number?: number | string;
  /** Label word, defaults to "Theorem" (also handy: Lemma / Proposition). */
  name?: string;
}

const { number, name = "Theorem" } = Astro.props;
---

<div class="theorem not-prose">
  <span class="theorem-label">
    {name}{number != null && number !== "" ? ` ${number}` : ""}.
  </span>
  <div class="theorem-body"><slot /></div>
</div>

<style>
  .theorem {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.75em;
    align-items: baseline;
    margin: 1.5rem 0;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    background: color-mix(in oklab, #f5c542 22%, transparent);
    font-family: "Times New Roman", Times, Georgia, "Songti SC", "SimSun", serif;
    font-size: 1rem;
    line-height: 1.7;
  }

  .theorem-label {
    font-weight: 700;
    font-style: normal;
    white-space: nowrap;
  }

  .theorem-body {
    font-style: italic;
  }

  /* Statement paragraphs sit flush inside their column. */
  .theorem-body :global(p) {
    margin: 0;
  }

  .theorem-body :global(p + p) {
    margin-top: 0.5rem;
  }

  :global([data-theme="dark"]) .theorem {
    background: color-mix(in oklab, #f5c542 14%, transparent);
  }
</style>
