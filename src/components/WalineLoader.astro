---
import { walineServerURL } from "@/data/waline";
const enabled = walineServerURL.trim() !== "";
const server = walineServerURL.trim();
---

{
  enabled && (
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@waline/client@v3/dist/waline.css" />
  )
}

{
  enabled && (
    <script is:inline define:vars={{ server }}>
      (function () {
        var mo = null;
        var timer = null;

        // Read-only pageview fill: fetch counts and fill every
        // `.waline-pageview-count` WITHOUT incrementing (the comment widget on
        // the post page handles the actual per-post increment).
        function fill() {
          if (!window.Waline) return;
          if (!document.querySelector(".waline-pageview-count")) return;
          try {
            window.Waline.pageviewCount({
              serverURL: server,
              update: false,
            });
          } catch (e) {}
        }

        function boot() {
          if (!window.Waline) return;

          fill();
          window.dispatchEvent(
            new CustomEvent("waline-ready", { detail: { serverURL: server } })
          );
          window.addEventListener("load", fill);
          // Astro's View Transitions swap the document per navigation, which can
          // detach listeners/observers. Re-fill a few ticks after each swap.
          setTimeout(fill, 400);
          setTimeout(fill, 1000);

          // (Re)attach to the CURRENT root — document.body is replaced on each
          // client-side navigation, so observe documentElement instead.
          if (mo) mo.disconnect();
          try {
            mo = new MutationObserver(function () {
              if (timer) clearTimeout(timer);
              timer = setTimeout(fill, 200);
            });
            mo.observe(document.documentElement, { childList: true, subtree: true });
          } catch (e) {}
        }

        document.addEventListener("astro:page-load", boot);

        if (window.Waline) return boot();

        // UMD build exposes a global `window.Waline` (the ES module `waline.js`
        // only exports named bindings, so we load the UMD variant instead).
        var s = document.createElement("script");
        s.src = "https://cdn.jsdelivr.net/npm/@waline/client@v3/dist/waline.umd.js";
        s.async = true;
        s.onload = boot;
        document.head.appendChild(s);
      })();
    </script>
  )
}
