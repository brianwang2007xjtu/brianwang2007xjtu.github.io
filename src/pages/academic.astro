---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const researchInterests = [
  "Brain-Computer Interface",
  "Machine Learning",
  "Neural Signal Processing",
  "Neuro-robotics",
];
---

<Layout title={`Academic | ${config.site.title}`}>
  <Header />

  <main id="main-content" class="app-layout-wide py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-medium sm:text-4xl">Academic</h1>
      <p class="mt-2 text-muted-foreground">
        My education and research interests.
      </p>
    </header>

    <section class="mb-10">
      <h2 class="mb-4 text-xl font-semibold tracking-wide">Education</h2>
      <div class="flex flex-col gap-3">
        <a
          href="http://www.aiar.xjtu.edu.cn/"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-2xl border border-border bg-background p-5 transition-colors hover:bg-muted"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="font-medium transition-colors group-hover:text-accent">
                Xi&#39;an Jiaotong University
              </div>
              <div class="mt-1 text-sm text-muted-foreground">
                Sophomore · Artificial Intelligence
              </div>
            </div>
            <span class="text-sm whitespace-nowrap text-muted-foreground">
              Sep 2025 – Now
            </span>
          </div>
        </a>
        <a
          href="https://baike.baidu.com/item/%E8%A5%BF%E5%AE%89%E4%BA%A4%E9%80%9A%E5%A4%A7%E5%AD%A6%E5%B0%91%E5%B9%B4%E7%8F%AD/58501505"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-2xl border border-border bg-background p-5 transition-colors hover:bg-muted"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="font-medium transition-colors group-hover:text-accent">
                Xi&#39;an Jiaotong University · 少年班
              </div>
              <div class="mt-1 text-sm text-muted-foreground">
                Special Class for the Gifted
              </div>
            </div>
            <span class="text-sm whitespace-nowrap text-muted-foreground">
              Sep 2023 – Jun 2025
            </span>
          </div>
        </a>
      </div>
    </section>

    <section>
      <h2 class="mb-4 text-xl font-semibold tracking-wide">
        Research Interests
      </h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {
          researchInterests.map(interest => (
            <div
              class="rounded-xl border border-border/60 bg-gradient-to-r from-muted/80 via-muted/60 to-muted/80 px-4 py-3 text-sm font-medium text-muted-foreground backdrop-blur-sm"
            >
              {interest}
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>
