---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostCard from "@/components/PostCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { blogCategories } from "@/data/categories";
import { collections } from "@/data/collections";
import config from "@/config";

export async function getStaticPaths() {
  return blogCategories.map(cat => ({
    params: { category: cat.slug },
    props: { ...cat },
  }));
}

const { slug: category, label, description } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;

const categoryPosts = await getCollection(
  "posts",
  ({ data }) => !data.draft && data.category === category
);
const sortedPosts = getSortedPosts(categoryPosts);

// Tags shown are only those belonging to THIS category's posts.
const tags = getUniqueTags(categoryPosts);
---

<Layout title={`${label} | ${config.site.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout-wide py-8"
  >
    <div class="grid gap-y-12 sm:grid-cols-[minmax(0,1fr)_280px] sm:gap-x-8">
      <section>
        <header class="mb-6">
          <h1 class="text-3xl font-medium sm:text-4xl">{label}</h1>
          <p class="mt-2 text-muted-foreground">{description}</p>
        </header>

        {
          sortedPosts.length > 0 ? (
            <ul class="flex flex-col gap-4">
              {sortedPosts.map(post => <PostCard {...post} />)}
            </ul>
          ) : (
            <p class="text-muted-foreground">No posts here yet.</p>
          )
        }
      </section>

      <aside class="text-sm">
        <div class="mb-8">
          <h2 class="mb-4 text-lg font-semibold">Collections</h2>
          <ul class="flex flex-col gap-2">
            {
              collections.map(c => (
                <li>
                  <a
                    href={getRelativeLocaleUrl(locale, `collection/${c.slug}`)}
                    class="block rounded-xl border border-border bg-background px-4 py-3 transition-colors hover:bg-muted"
                  >
                    <span class="font-medium">{c.title}</span>
                    <p class="mt-0.5 line-clamp-1 text-xs text-muted-foreground">
                      {c.description}
                    </p>
                  </a>
                </li>
              ))
            }
          </ul>
          <a
            href={getRelativeLocaleUrl(locale, "collection")}
            class="mt-3 block text-end text-sm text-muted-foreground hover:text-accent"
          >
            View all →
          </a>
        </div>

        <div>
          <h2 class="mb-4 text-lg font-semibold">Tags</h2>
          <ul class="flex flex-wrap gap-3">
            {
              tags.map(({ tag, tagName }) => (
                <li>
                  <a
                    href={getRelativeLocaleUrl(locale, `tags/${tag}`)}
                    class="rounded-full border border-border bg-muted px-3.5 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:border-foreground/20 hover:text-foreground"
                  >
                    {tagName}
                  </a>
                </li>
              ))
            }
          </ul>
          <a
            href={getRelativeLocaleUrl(locale, "tags")}
            class="mt-3 block text-end text-sm text-muted-foreground hover:text-accent"
          >
            View all →
          </a>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>
