---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostCard from "@/components/PostCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { collections } from "@/data/collections";
import config from "@/config";

export async function getStaticPaths() {
  return collections.map(c => ({
    params: { slug: c.slug },
    props: { ...c },
  }));
}

const { title, description, tag } = Astro.props;

const posts = await getCollection(
  "posts",
  ({ data }) => !data.draft && data.tags.includes(tag)
);
const sortedPosts = getSortedPosts(posts);
---

<Layout title={`${title} | ${config.site.title}`}>
  <Header />

  <main id="main-content" data-back-url-page class="app-layout-wide py-8">
    <header class="mb-8 overflow-hidden rounded-2xl border border-border">
      <div class="bg-gradient-to-r from-accent/15 via-accent/5 to-transparent p-6 sm:p-8">
        <h1 class="text-3xl font-bold sm:text-4xl">{title}</h1>
        <p class="mt-2 max-w-xl text-muted-foreground">{description}</p>
        <span class="mt-3 inline-block text-sm text-muted-foreground">
          {sortedPosts.length} posts
        </span>
      </div>
    </header>

    <section>
      {
        sortedPosts.length > 0 ? (
          <ul class="flex flex-col gap-4">
            {sortedPosts.map(post => <PostCard {...post} />)}
          </ul>
        ) : (
          <p class="text-muted-foreground">No posts in this collection yet.</p>
        )
      }
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector("#main-content");
    if (main?.hasAttribute("data-back-url-page")) {
      sessionStorage.setItem("backUrl", window.location.pathname);
    }
  });
</script>
