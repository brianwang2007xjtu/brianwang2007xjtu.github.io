---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { collections } from "@/data/collections";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Compute how many posts belong to each collection.
const posts = await getCollection("posts", ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const collection of collections) {
  counts.set(
    collection.slug,
    posts.filter(p => p.data.tags.includes(collection.tag)).length
  );
}
---

<Layout title={`Collections | ${config.site.title}`}>
  <Header />

  <main id="main-content" class="app-layout-wide py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-medium sm:text-4xl">Collections</h1>
      <p class="mt-2 text-muted-foreground">
        Curated collections of posts grouped by topic.
      </p>
    </header>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        collections.map(c => (
          <a
            href={getRelativeLocaleUrl(locale, `collection/${c.slug}`)}
            class="group rounded-2xl border border-border bg-background p-5 transition-colors hover:bg-muted"
          >
            <div class="flex items-start justify-between gap-2">
              <h2 class="font-medium transition-colors group-hover:text-accent">
                {c.title}
              </h2>
              <span class="rounded-full border border-border bg-muted px-2.5 py-0.5 text-xs whitespace-nowrap text-muted-foreground">
                {counts.get(c.slug) ?? 0}
              </span>
            </div>
            <p class="mt-1 text-sm text-muted-foreground">{c.description}</p>
          </a>
        ))
      }
    </div>
  </main>

  <Footer />
</Layout>
