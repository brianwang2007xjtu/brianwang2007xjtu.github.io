---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import PostCard from "@/components/PostCard.astro";
import ContributionHeatmap from "@/components/ContributionHeatmap.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import {
  getDaysOnline,
  getLastUpdated,
  getTotalWords,
  formatStatsDate,
  formatWords,
} from "@/utils/getBlogStats";
import { getContributions } from "@/utils/getContributions";
import config from "@/config";
import avatar from "@/assets/images/8CBB3CC5-C7FE-425F-8008-18668A098F3B.jpeg";

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts", ({ data }) => !data.draft);
const totalPosts = posts.length;
const recentPosts = getSortedPosts(posts).slice(0, 3);

// Real, auto-updating stats.
const SITE_ONLINE_SINCE = new Date("2026-08-27T00:00:00Z"); // launch day = day 1
const daysOnline = getDaysOnline(SITE_ONLINE_SINCE);
const lastUpdated = getLastUpdated(posts);
const totalWords = getTotalWords(posts);
const contributions = getContributions(posts);

const homePath = getRelativeLocaleUrl(locale, "");
const postsHref = getRelativeLocaleUrl(locale, "posts");
const aboutHref = getRelativeLocaleUrl(locale, "about");
---

<Layout>
  <Header narrow />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout-home my-1"
  >
    <!-- Hero -->
    <section class="flex flex-col gap-8 pt-8 pb-12 sm:flex-row sm:items-center">
      <img
        src={avatar.src}
        alt="master's avatar"
        width="144"
        height="144"
        class="h-32 w-32 shrink-0 rounded-2xl border border-border object-cover sm:h-36 sm:w-36"
      />
      <div class="flex flex-col gap-4">
        <h1 class="text-3xl font-bold sm:text-4xl">Master</h1>
        <p class="max-w-xl text-muted-foreground">
          Hi, I&#39;m master — an undergraduate at Xi&#39;an Jiaotong
          University working on brain-computer interfaces.{" "}
          <a
            href={aboutHref}
            class="text-accent decoration-dashed underline-offset-4 hover:underline"
          >
            More about me
          </a>
        </p>
        <div class="flex flex-wrap items-center gap-2">
          <div
            class="flex items-center gap-2 rounded-lg border border-border/60 bg-gradient-to-r from-muted/80 via-muted/60 to-muted/80 px-3 py-2 text-sm font-medium text-muted-foreground backdrop-blur-sm"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path>
              <path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z"></path>
            </svg>
            <span>China</span>
          </div>
          <Socials />
        </div>
      </div>
    </section>

    <!-- Statistics -->
    <section class="flex min-w-0 flex-col gap-y-3">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-xl font-semibold">Statistics</h2>
      </div>
      <div class="grid min-w-0 grid-cols-1 gap-4 sm:grid-cols-3">
          <!-- Days Online -->
          <div class="group flex flex-col items-center gap-2 rounded-lg border border-border bg-card p-4 shadow-sm transition-all hover:border-foreground/25 hover:shadow-lg">
            <svg
              aria-hidden="true"
              class="size-5 text-muted-foreground transition-colors group-hover:text-accent"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <g fill="none">
                <path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"></path>
                <path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m0 2a8 8 0 1 0 0 16a8 8 0 0 0 0-16m0 2a1 1 0 0 1 .993.883L13 7v4.586l2.707 2.707a1 1 0 0 1-1.32 1.497l-.094-.083l-3-3a1 1 0 0 1-.284-.576L11 12V7a1 1 0 0 1 1-1"></path>
              </g>
            </svg>
            <div class="text-center">
              <div
                class="text-2xl font-bold text-foreground transition-colors group-hover:text-accent"
                data-days-online
                data-start="2026-08-27"
              >
                {daysOnline}
              </div>
              <div class="text-sm text-muted-foreground">Days Online</div>
            </div>
          </div>
          <!-- Last Updated -->
          <div class="group flex flex-col items-center gap-2 rounded-lg border border-border bg-card p-4 shadow-sm transition-all hover:border-foreground/25 hover:shadow-lg">
            <svg
              aria-hidden="true"
              class="size-5 text-muted-foreground transition-colors group-hover:text-accent"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <g fill="none" fill-rule="evenodd">
                <path d="m12.594 23.258l-.012.002l-.071.035l-.02.004l-.014-.004l-.071-.036q-.016-.004-.024.006l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.016-.018m.264-.113l-.014.002l-.184.093l-.01.01l-.003.011l.018.43l.005.012l.008.008l.201.092q.019.005.029-.008l.004-.014l-.034-.614q-.005-.019-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"></path>
                <path fill="currentColor" d="M16 3a1 1 0 0 1 1 1v1h2a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2V4a1 1 0 0 1 2 0v1h6V4a1 1 0 0 1 1-1M8 7H5v2h14V7h-3zm-3 4v8h14v-8zm2 2a1 1 0 0 1 1-1h.01a1 1 0 1 1 0 2H8a1 1 0 0 1-1-1m1 2a1 1 0 1 0 0 2h.01a1 1 0 1 0 0-2zm3-2a1 1 0 0 1 1-1h.01a1 1 0 1 1 0 2H12a1 1 0 0 1-1-1m1 2a1 1 0 1 0 0 2h.01a1 1 0 1 0 0-2zm3-2a1 1 0 0 1 1-1h.01a1 1 0 1 1 0 2H16a1 1 0 0 1-1-1m1 2a1 1 0 1 0 0 2h.01a1 1 0 1 0 0-2z"></path>
              </g>
            </svg>
            <div class="text-center">
              <div class="text-sm font-medium text-foreground transition-colors group-hover:text-accent">
                {lastUpdated ? formatStatsDate(lastUpdated) : "—"}
              </div>
              <div class="text-sm text-muted-foreground">Last Updated</div>
            </div>
          </div>
          <!-- Total Posts -->
          <div class="group flex flex-col items-center gap-2 rounded-lg border border-border bg-card p-4 shadow-sm transition-all hover:border-foreground/25 hover:shadow-lg">
            <svg
              aria-hidden="true"
              class="size-5 text-muted-foreground transition-colors group-hover:text-accent"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <g fill="none">
                <path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"></path>
                <path fill="currentColor" d="M18 2a2 2 0 0 1 2 2v11.586A2 2 0 0 1 19.414 17L15 21.414a2 2 0 0 1-1.414.586H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm0 2H6v16h6v-4.5a1.5 1.5 0 0 1 1.5-1.5H18zm-.414 12H14v3.586zM10 11a1 1 0 1 1 0 2H9a1 1 0 1 1 0-2zm5-4a1 1 0 1 1 0 2H9a1 1 0 1 1 0-2Z"></path>
              </g>
            </svg>
            <div class="text-center">
              <div class="text-2xl font-bold text-foreground transition-colors group-hover:text-accent">
                {totalPosts}
              </div>
              <div class="text-sm text-muted-foreground">Total Posts</div>
            </div>
          </div>
        </div>
        <div class="flex items-center justify-between border-border border-t pt-3 text-sm">
          <span class="text-muted-foreground">Total Words</span>
          <span class="font-medium text-foreground">{formatWords(totalWords)}</span>
        </div>
        <ContributionHeatmap
          contributions={contributions}
          since={SITE_ONLINE_SINCE.toISOString().slice(0, 10)}
        />
    </section>

    <!-- Recent posts -->
    <section class="pt-12 pb-4">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-xl font-semibold">Recent Posts</h2>
        <a
          href={postsHref}
          class="text-sm text-muted-foreground transition-colors hover:text-accent"
        >
          All posts →
        </a>
      </div>
      {
        recentPosts.length > 0 ? (
          <ul class="flex flex-col gap-4">
            {recentPosts.map(post => <PostCard {...post} />)}
          </ul>
        ) : (
          <p class="text-muted-foreground">No posts yet.</p>
        )
      }
    </section>
  </main>

  <Footer narrow />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    // Remember that the Go Back button should return to the homepage.
    const indexLayout = (
      document.querySelector("#main-content") as HTMLElement
    )?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
    // Keep "Days Online" accurate even when the page is cached across midnight.
    const el = document.querySelector<HTMLElement>("[data-days-online]");
    if (!el) return;
    const start = new Date(`${el.dataset.start}T00:00:00Z`);
    const now = new Date();
    const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
    const startUTC = Date.UTC(
      start.getUTCFullYear(),
      start.getUTCMonth(),
      start.getUTCDate()
    );
    const days = Math.max(1, Math.floor((today - startUTC) / 86400000) + 1);
    el.textContent = String(days);
  });
</script>
