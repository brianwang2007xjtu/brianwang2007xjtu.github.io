---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import PostCard from "@/components/PostCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { getGithubStars } from "@/utils/getGithubStars";
import { walineServerURL } from "@/data/waline";
import config from "@/config";
import avatar from "@/assets/images/8CBB3CC5-C7FE-425F-8008-18668A098F3B.jpeg";

const { posts: postsConfig } = config;
const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts", ({ data }) => !data.draft);
const totalPosts = posts.length;
const recentPosts = getSortedPosts(posts).slice(0, postsConfig.perIndex);

// Real, auto-updating stats.
const githubStars = await getGithubStars();
const allPostPaths = posts.map(p =>
  getPostUrl(p.id, p.filePath, locale).replace(/\/+$/, "")
);

const homePath = getRelativeLocaleUrl(locale, "");
const postsHref = getRelativeLocaleUrl(locale, "posts");
const aboutHref = getRelativeLocaleUrl(locale, "about");
---

<Layout>
  <Header />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout-wide my-1"
  >
    <!-- Hero -->
    <section class="flex flex-col gap-8 pt-8 pb-12 sm:flex-row sm:items-center">
      <img
        src={avatar.src}
        alt="master's avatar"
        width="144"
        height="144"
        class="h-32 w-32 shrink-0 rounded-2xl border border-border object-cover sm:h-36 sm:w-36"
      />
      <div class="flex flex-col gap-4">
        <h1 class="text-3xl font-bold sm:text-4xl">Master</h1>
        <p class="max-w-xl text-muted-foreground">
          Hi, I&#39;m master — an undergraduate at Xi&#39;an Jiaotong
          University working on brain-computer interfaces.{" "}
          <a
            href={aboutHref}
            class="text-accent decoration-dashed underline-offset-4 hover:underline"
          >
            More about me
          </a>
        </p>
        <div class="flex flex-wrap items-center gap-2">
          <div
            class="flex items-center gap-2 rounded-lg border border-border/60 bg-gradient-to-r from-muted/80 via-muted/60 to-muted/80 px-3 py-2 text-sm font-medium text-muted-foreground backdrop-blur-sm"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path>
              <path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z"></path>
            </svg>
            <span>China</span>
          </div>
          <Socials />
        </div>
      </div>
    </section>

    <!-- Statistics -->
    <section class="border-border border-t pt-10 pb-4">
      <h2 class="text-2xl font-semibold tracking-wide">Statistics</h2>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-border/60 bg-gradient-to-r from-muted/80 via-muted/60 to-muted/80 p-5 backdrop-blur-sm transition-colors hover:border-accent/30">
          <div class="text-3xl font-bold tabular-nums">{totalPosts}</div>
          <div class="mt-1 text-sm text-muted-foreground">Total Posts</div>
        </div>
        <div
          class="rounded-2xl border border-border/60 bg-gradient-to-r from-muted/80 via-muted/60 to-muted/80 p-5 backdrop-blur-sm transition-colors hover:border-accent/30"
          data-waline-paths={JSON.stringify(allPostPaths)}
        >
          <div class="text-3xl font-bold tabular-nums">
            <span id="total-visits">—</span>
          </div>
          <div class="mt-1 text-sm text-muted-foreground">Total Visits</div>
        </div>
        <div class="rounded-2xl border border-border/60 bg-gradient-to-r from-muted/80 via-muted/60 to-muted/80 p-5 backdrop-blur-sm transition-colors hover:border-accent/30">
          <div class="text-3xl font-bold tabular-nums">{githubStars}</div>
          <div class="mt-1 text-sm text-muted-foreground">GitHub Stars</div>
        </div>
      </div>
    </section>

    <!-- Recent posts -->
    <section class="pt-12 pb-4">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
        <a
          href={postsHref}
          class="text-sm text-muted-foreground transition-colors hover:text-accent"
        >
          All posts →
        </a>
      </div>
      {
        recentPosts.length > 0 ? (
          <ul class="flex flex-col gap-4">
            {recentPosts.map(post => <PostCard {...post} />)}
          </ul>
        ) : (
          <p class="text-muted-foreground">No posts yet.</p>
        )
      }
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (
      document.querySelector("#main-content") as HTMLElement
    )?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

<script is:inline define:vars={{ walineServerURL }}>
  (function () {
    const run = () => {
      const el = document.querySelector("#total-visits");
      if (!el) return;
      const host = el.closest("[data-waline-paths]");
      const paths = host?.getAttribute("data-waline-paths") || "";
      if (!window.Waline || !paths) return;
      try {
        window.Waline.getArticleCounter({
          serverURL: walineServerURL,
          paths: JSON.parse(paths),
          type: ["pageview"],
        })
          .then(rows => {
            const total = (Array.isArray(rows) ? rows : []).reduce(
              (sum, r) => sum + (r?.pageview || 0),
              0
            );
            el.textContent = total.toLocaleString();
          })
          .catch(() => {});
      } catch (e) {}
    };
    document.addEventListener("waline-ready", run, { once: true });
    if (window.Waline) run();
  })();
</script>
