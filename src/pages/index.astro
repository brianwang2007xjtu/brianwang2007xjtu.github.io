---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import avatar from "@/assets/images/8CBB3CC5-C7FE-425F-8008-18668A098F3B.jpeg";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const totalPosts = posts.length;
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <div class="flex items-center justify-center gap-6">
        <img
          src={avatar.src}
          alt="master的头像"
          width="100"
          height="100"
          class="rounded-full object-cover"
        />
      </div>
      <div class="flex items-center justify-center gap-6 mt-6">
        <h1 class="text-3xl font-bold sm:text-4xl">
          Master
        </h1>
      </div>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center justify-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <section id="about" class="border-border border-b pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">About</h2>
      <div class="mt-4 space-y-6">
        <p class="text-base leading-relaxed">
          我是一名西安交通大学的 sophomore，从事脑机接口领域的研究。
          <a href="/about" class="hover:text-accent underline decoration-dashed underline-offset-4">
            More about me
          </a>
        </p>
        <div>
          <h3 class="text-lg font-semibold">Education</h3>
          <div class="mt-2 space-y-3">
            <a href="http://www.aiar.xjtu.edu.cn/" target="_blank" rel="noopener" class="group block border border-current rounded px-4 py-2 hover:bg-accent transition-colors">
              <div class="font-medium group-hover:text-white">西安交通大学</div>
              <div class="text-sm text-muted-foreground group-hover:text-white">人工智能专业，本科</div>
              <div class="text-sm text-muted-foreground group-hover:text-white">Sep 2022 – Jun 2026</div>
            </a>
          </div>
        </div>
        <div>
          <h3 class="text-lg font-semibold">Statistics</h3>
          <div class="mt-2 grid grid-cols-2 gap-4 sm:grid-cols-4">
            <div>
              <div class="text-3xl font-bold">788</div>
              <div class="text-sm text-muted-foreground">Days Online</div>
            </div>
            <div>
              <div class="text-3xl font-bold">Aug 11, 2026</div>
              <div class="text-sm text-muted-foreground">Last Updated</div>
            </div>
            <div>
              <div class="text-3xl font-bold">36w</div>
              <div class="text-sm text-muted-foreground">Total Words</div>
            </div>
            <div>
              <div class="text-3xl font-bold">{totalPosts}</div>
              <div class="text-sm text-muted-foreground">Total Posts</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
