---
import type { MediaMetaItem, MediaSection } from "@/types/media";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import MediaCard from "@/components/MediaCard.astro";
import MediaModal from "@/components/MediaModal.astro";
import { movies, type Movie } from "@/data/movies";
import config from "@/config";

function movieMeta(m: Movie): MediaMetaItem[] {
  const meta: MediaMetaItem[] = [];
  if (m.cast) meta.push({ label: "Cast", value: m.cast });
  if (m.category) meta.push({ label: "Category", value: m.category });
  return meta;
}

function movieSections(m: Movie): MediaSection[] {
  return [{ label: "About", body: m.details }];
}
---

<Layout title={`Movies | ${config.site.title}`}>
  <Header />

  <main id="main-content" class="app-layout-wide py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-medium sm:text-4xl">Movies</h1>
      <p class="mt-2 text-muted-foreground">
        Films I love — slow burns, grand spectacles, and everything in between.
      </p>
    </header>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        movies.map(movie => (
          <MediaCard
            title={movie.title}
            subtitle={movie.director}
            description={movie.description}
            cover={movie.poster}
            icon="film"
            badge={movie.year ? String(movie.year) : undefined}
            meta={movieMeta(movie)}
            quote={movie.quote ? { label: "Favorite line", text: movie.quote } : undefined}
            sections={movieSections(movie)}
          />
        ))
      }
    </div>
  </main>

  <MediaModal />

  <Footer />
</Layout>
