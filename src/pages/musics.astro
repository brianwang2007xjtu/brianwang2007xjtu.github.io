---
import type { MediaMetaItem, MediaSection } from "@/types/media";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import MediaCard from "@/components/MediaCard.astro";
import MediaModal from "@/components/MediaModal.astro";
import { albums, type Album } from "@/data/music";
import config from "@/config";

const classical = albums.filter(a => a.category === "classical");
const nonClassical = albums.filter(a => a.category === "non-classical");

const classicalTabs = [
  { key: "symphonies", label: "Symphonies" },
  { key: "operas", label: "Operas" },
  { key: "concertos", label: "Concertos" },
  { key: "others", label: "Others" },
];

function albumMeta(a: Album): MediaMetaItem[] {
  const meta: MediaMetaItem[] = [];
  if (a.conductor) meta.push({ label: "Conductor", value: a.conductor });
  if (a.orchestra) meta.push({ label: "Orchestra", value: a.orchestra });
  if (a.soloist) meta.push({ label: "Soloist", value: a.soloist });
  if (a.vocalists) meta.push({ label: "Vocalists", value: a.vocalists });
  if (a.releaseDate) meta.push({ label: "Release", value: a.releaseDate });
  if (a.catalogNumber)
    meta.push({ label: "Catalog No.", value: a.catalogNumber });
  if (a.albumType)
    meta.push({
      label: "Type",
      value: a.albumType === "studio" ? "Studio Album" : "Live Album",
    });
  return meta;
}

function albumSections(a: Album): MediaSection[] {
  return [
    { label: "Why I recommend", body: a.recommendation },
    { label: "About", body: a.details },
  ];
}
---

<Layout title={`Music | ${config.site.title}`}>
  <Header />

  <main id="main-content" class="app-layout-wide py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-medium sm:text-4xl">Music</h1>
      <p class="mt-2 text-muted-foreground">
        Albums I keep coming back to, classical and otherwise.
      </p>
    </header>

    <section class="mb-10">
      <h2 class="mb-4 text-xl font-semibold tracking-wide">Classical</h2>

      <div
        class="mb-4 flex flex-wrap gap-2"
        role="tablist"
        aria-label="Classical subcategories"
      >
        {
          classicalTabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              data-subcat={tab.key}
              class:list={[
                "rounded-full border border-border px-4 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-accent",
                { "border-accent/40 bg-muted text-accent": i === 0 },
              ]}
            >
              {tab.label}
            </button>
          ))
        }
      </div>

      <div id="classical-grid" class="grid gap-4 sm:grid-cols-2">
        {
          classical.map(album => (
            <MediaCard
              title={album.title}
              subtitle={album.artist}
              description={album.description}
              cover={album.cover}
              icon="music"
              badge="Classical"
              subcategory={album.subCategory}
              class={album.subCategory === "symphonies" ? "" : "hidden"}
              action={{ label: "Try", href: album.listenUrl ?? "#" }}
              meta={albumMeta(album)}
              sections={albumSections(album)}
            />
          ))
        }
      </div>
    </section>

    <section>
      <h2 class="mb-4 text-xl font-semibold tracking-wide">Non-Classical</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          nonClassical.map(album => (
            <MediaCard
              title={album.title}
              subtitle={album.artist}
              description={album.description}
              cover={album.cover}
              icon="music"
              badge="Non-Classical"
              action={{ label: "Try", href: album.listenUrl ?? "#" }}
              meta={albumMeta(album)}
              sections={albumSections(album)}
            />
          ))
        }
      </div>
    </section>
  </main>

  <MediaModal />

  <Footer />
</Layout>

<script>
  function initMusicTabs() {
    const tabs = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-subcat]")
    );
    const items = Array.from(
      document.querySelectorAll<HTMLElement>(
        "#classical-grid [data-media-card]"
      )
    );
    if (tabs.length === 0 || items.length === 0) return () => {};

    function activate(key: string) {
      for (const t of tabs) {
        const active = t.dataset.subcat === key;
        t.classList.toggle("bg-muted", active);
        t.classList.toggle("text-accent", active);
        t.classList.toggle("border-accent/40", active);
        t.setAttribute("aria-selected", active ? "true" : "false");
      }
      for (const it of items) {
        const sub = it.dataset.subcategory ?? "";
        it.classList.toggle("hidden", sub !== key);
      }
    }

    const onClick = (e: Event) => {
      const key = (e.currentTarget as HTMLElement).dataset.subcat;
      if (key) activate(key);
    };
    for (const t of tabs) t.addEventListener("click", onClick);
    activate("symphonies");

    return () => {
      for (const t of tabs) t.removeEventListener("click", onClick);
    };
  }

  let cleanup: (() => void) | undefined;
  document.addEventListener("astro:page-load", () => {
    cleanup?.();
    cleanup = initMusicTabs();
  });
</script>
