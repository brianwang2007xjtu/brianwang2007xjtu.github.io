---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import PostCard from "@/components/PostCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return paginate(getSortedPosts(posts), { pageSize: config.posts.perPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout title={`Blog | ${config.site.title}`}>
  <Header />

  <main id="main-content" data-posts-page class="app-layout-wide py-8">
    <header
      class="mb-8 flex flex-col justify-between gap-2 sm:flex-row sm:items-end"
    >
      <div>
        <h1 class="text-3xl font-medium sm:text-4xl">Blog</h1>
        <p class="mt-2 text-muted-foreground">
          All the articles I&#39;ve posted.
        </p>
      </div>
      <span class="text-sm whitespace-nowrap text-muted-foreground">
        Showing {page.start + 1}–{page.end + 1} of {page.total} posts
      </span>
    </header>

    <ul class="flex flex-col gap-4">
      {page.data.map(post => <PostCard {...post} />)}
    </ul>
  </main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector("#main-content");
    // Only record the referrer when actually on the listing page so the
    // persisted listener doesn't overwrite it after navigating into a post.
    if (main?.hasAttribute("data-posts-page")) {
      sessionStorage.setItem("backUrl", window.location.pathname);
    }
  });
</script>
