---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import MotionEmbed from "@/components/MotionEmbed.astro";
import config from "@/config";
---

<Layout
  title={`SuperMimic 复现 · 动作演示 | ${config.site.title}`}
  description="SuperMimic 复现：选择一个动作，播放训练策略在 MuJoCo 中跟踪参考动捕的视频。"
>
  <Header />
  <Main
    pageTitle={["SuperMimic 动作演示", "SuperMimic Motion Demo"]}
    pageDesc="选择一个动作，播放 SuperMimic 策略（44,000 迭代）在 MuJoCo 中的跟踪回放。青色半透明为参考动作，实心机器人为策略。"
  >
    <div class="mx-auto mt-6 max-w-4xl">
      <MotionEmbed />
    </div>
  </Main>
  <Footer />
</Layout>
